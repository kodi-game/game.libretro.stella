diff --git a/src/common/BitmaskEnum.hxx b/src/common/BitmaskEnum.hxx
index a269e9a4e..0c6adce63 100644
--- a/src/common/BitmaskEnum.hxx
+++ b/src/common/BitmaskEnum.hxx
@@ -3,9 +3,8 @@
     Based on work by Andre Haupt from his blog at
     http://blog.bitwigglers.org/using-enum-classes-as-type-safe-bitmasks/
 
-    C++20 modernization: concepts replace enable_if, requires-clauses replace
-    SFINAE, redundant inline/typename removed. Macro removed in favour of a
-    direct variable template specialization.
+    Enum participation is controlled by a direct variable template
+    specialization, with C++17-compatible trait constraints.
 
     To enable enum classes to be used as bitmasks, specialize is_bitmask_enum_v:
 
@@ -20,7 +19,7 @@
     From now on, MyBitmask's values can be used with bitwise operators.
     Wrap in BitmaskEnum for ergonomic checks:
 
-    Bitmask::Enum wbm{bm};
+    Bitmask::Enum<MyBitmask> wbm{bm};
     wbm.any_of(MyBitmask::One | MyBitmask::Three);
     wbm.all_of(MyBitmask::One | MyBitmask::Three);
     if (wbm) { ... }                 // any bit set?
@@ -54,11 +53,12 @@
 #ifndef BITMASK_ENUM_HXX
 #define BITMASK_ENUM_HXX
 
-#include <bit>
-#include <concepts>
+#if __has_include(<bit>)
+  #include <bit>
+#endif
+#include <cstring>
 #include <limits>
 #include <type_traits>
-#include <utility>
 
 namespace Bitmask {
 
@@ -70,41 +70,64 @@ template<typename Enum>
 inline constexpr bool is_enum_v = false;
 
 // ---------------------------------------------------------------------------
-// Concept
+// Opt-in validation
 // ---------------------------------------------------------------------------
 
+template<typename Enum, bool = std::is_enum_v<Enum>>
+struct is_type: std::false_type { };
+
+template<typename Enum>
+struct is_type<Enum, true>: std::bool_constant<
+    std::is_unsigned_v<std::underlying_type_t<Enum>> && is_enum_v<Enum>> { };
+
 template<typename Enum>
-concept Type =
-    std::is_enum_v<Enum> &&
-    std::is_unsigned_v<std::underlying_type_t<Enum>> &&
-    is_enum_v<Enum>;
+inline constexpr bool is_type_v = is_type<Enum>::value;
 
 // ---------------------------------------------------------------------------
 // Underlying helpers (safe conversion boundary)
 // ---------------------------------------------------------------------------
 
-template<Type Enum>
+template<typename Enum, std::enable_if_t<is_type_v<Enum>, int> = 0>
 [[nodiscard]] constexpr std::underlying_type_t<Enum>
 to_underlying(Enum e) noexcept {
-    return std::to_underlying(e);
+    return static_cast<std::underlying_type_t<Enum>>(e);
 }
 
-template<Type Enum>
+template<typename Enum, std::enable_if_t<is_type_v<Enum>, int> = 0>
 [[nodiscard]] constexpr Enum
 from_underlying(std::underlying_type_t<Enum> v) noexcept {
-    // static_cast<Enum> triggers clang-analyzer-optin.core.EnumCastOutOfRange
-    // for combined bitmask values that don't match a named enumerator.
-    // std::bit_cast is well-defined for same-size trivially-copyable types
-    // and produces identical codegen without the diagnostic.
+    // Combined masks need not correspond to a named enumerator.  Preserve the
+    // representation instead of using an enum cast, which triggers Clang's
+    // EnumCastOutOfRange analyzer check for those valid bitmask values.
+#if defined(__cpp_lib_bit_cast) && __cpp_lib_bit_cast >= 201806L && \
+    !defined(BITMASK_FORCE_MEMCPY_BIT_CAST)
     return std::bit_cast<Enum>(v);
+#elif defined(__has_builtin) && !defined(BITMASK_FORCE_MEMCPY_BIT_CAST)
+  #if __has_builtin(__builtin_bit_cast)
+    return __builtin_bit_cast(Enum, v);
+  #else
+    static_assert(sizeof(Enum) == sizeof(v));
+    Enum result{};
+    std::memcpy(&result, &v, sizeof(result));
+    return result;
+  #endif
+#else
+    static_assert(sizeof(Enum) == sizeof(v));
+    Enum result{};
+    std::memcpy(&result, &v, sizeof(result));
+    return result;
+#endif
 }
 
 // ---------------------------------------------------------------------------
 // Bitmask wrapper
 // ---------------------------------------------------------------------------
 
-template<Type Enum>
+template<typename Enum>
 struct BitmaskEnum {
+    static_assert(is_type_v<Enum>,
+        "BitmaskEnum requires an opted-in unsigned enum type");
+
     Enum value;
 
     static constexpr Enum none{};
@@ -151,7 +174,14 @@ struct BitmaskEnum {
 //     }
 
     friend constexpr bool
-    operator==(BitmaskEnum, BitmaskEnum) noexcept = default;
+    operator==(BitmaskEnum lhs, BitmaskEnum rhs) noexcept {
+        return lhs.value == rhs.value;
+    }
+
+    friend constexpr bool
+    operator!=(BitmaskEnum lhs, BitmaskEnum rhs) noexcept {
+        return !(lhs == rhs);
+    }
 
     constexpr BitmaskEnum& operator|=(Enum rhs) noexcept {
         value = from_underlying<Enum>(to_underlying(value) | to_underlying(rhs));
