+  #elif (defined(__clang__) || defined(__GNUC__)) && \
+        !defined(BSPF_FORCE_PORTABLE_BYTESWAP)
+    if constexpr(sizeof(T) == 1)
+      return value;
+    else if constexpr(sizeof(T) == 2)
