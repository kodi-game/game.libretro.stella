From 583eab1dc45f17c8e8a715879ca7f99f2061cece Mon Sep 17 00:00:00 2001
From: Garrett Brown <garrett@Garretts-MacBook-Pro.local>
Date: Fri, 21 Aug 2026 22:14:41 -0700
Subject: [PATCH] Fix C++23 flag for older AppleClang

---
 src/os/libretro/Makefile | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/os/libretro/Makefile b/src/os/libretro/Makefile
index 37c8bfff9..c93d8d5c0 100644
--- a/src/os/libretro/Makefile
+++ b/src/os/libretro/Makefile
@@ -45,9 +45,22 @@ endif
 
 TARGET_NAME = stella
 
+CXX_STANDARD_FLAG := -std=c++23
+# Some AppleClang releases expose C++23 only under its draft spelling.
+ifeq ($(platform), osx)
+   CXX_STANDARD_FLAG := $(shell \
+      if printf '' | $(CXX) -x c++ -std=c++23 -fsyntax-only - >/dev/null 2>&1; then \
+         printf '%s' '-std=c++23'; \
+      elif printf '' | $(CXX) -x c++ -std=c++2b -fsyntax-only - >/dev/null 2>&1; then \
+         printf '%s' '-std=c++2b'; \
+      fi)
+   ifeq ($(CXX_STANDARD_FLAG),)
+      $(error $(CXX) supports neither -std=c++23 nor -std=c++2b)
+   endif
+endif
 
 ifeq (,$(findstring msvc,$(platform)))
-   CXXFLAGS += -std=c++23 -fno-rtti
+   CXXFLAGS += $(CXX_STANDARD_FLAG) -fno-rtti
    LIBS := -lm
 else
    LIBS :=
-- 
